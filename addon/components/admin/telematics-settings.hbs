<div class="space-y-6">
    <InfoBlock @type="info" @icon="circle-info" class="mb-4">
        {{t "fleet-ops.admin-pages.telematics-settings.configure-telematics-retention-policy-and-activity"}}
    </InfoBlock>

    <ContentPanel @title={{t "fleet-ops.admin-pages.telematics-settings.system-device-events-retention-policy"}} @open={{true}} @wrapperClass="bordered-classic">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <InputGroup @name={{t "fleet-ops.admin-pages.telematics-settings.default-device-event-retention-days"}} @helpText={{t "fleet-ops.admin-pages.telematics-settings.retention-for-organizations-that-inherit-the"}}>
                <Input @type="number" @value={{this.eventRetentionDays}} min="0" max="3650" class="form-input w-full" />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.admin-pages.telematics-settings.maximum-device-event-retention-days"}} @helpText={{t "fleet-ops.admin-pages.telematics-settings.the-longest-any-organization-can-keep"}}>
                <Input @type="number" @value={{this.maxEventRetentionDays}} min="0" max="3650" class="form-input w-full" />
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "fleet-ops.admin-pages.telematics-settings.system-position-history-retention-policy"}} @open={{true}} @wrapperClass="bordered-classic">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <InputGroup @name={{t "fleet-ops.admin-pages.telematics-settings.default-position-history-retention-days"}} @helpText={{t "fleet-ops.admin-pages.telematics-settings.retention-for-organizations-that-inherit-the"}}>
                <Input @type="number" @value={{this.positionRetentionDays}} min="0" max="3650" class="form-input w-full" />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.admin-pages.telematics-settings.maximum-position-history-retention-days"}} @helpText={{t "fleet-ops.admin-pages.telematics-settings.the-longest-any-organization-can-keep-2"}}>
                <Input @type="number" @value={{this.maxPositionRetentionDays}} min="0" max="3650" class="form-input w-full" />
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "fleet-ops.admin-pages.telematics-settings.system-device-event-raw-payload-retention"}} @open={{true}} @wrapperClass="bordered-classic">
        <InputGroup @name={{t "fleet-ops.admin-pages.telematics-settings.device-event-raw-payload-retention-days"}} @helpText={{t "fleet-ops.admin-pages.telematics-settings.remove-raw-provider-payloads-from-retained"}}>
            <Input @type="number" @value={{this.eventCompactAfterDays}} min="0" max="3650" class="form-input w-full" />
        </InputGroup>
    </ContentPanel>

    <ContentPanel @title={{t "fleet-ops.admin-pages.telematics-settings.system-delivery-inbox-and-sync-run"}} @open={{true}} @wrapperClass="bordered-classic">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <InputGroup @name={{t "fleet-ops.admin-pages.telematics-settings.processed-delivery-retention-hours"}} @helpText={{t "fleet-ops.admin-pages.telematics-settings.delete-processed-delivery-envelopes-across-all"}}>
                <Input @type="number" @value={{this.processedRetentionHours}} min="0" max="720" class="form-input w-full" />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.admin-pages.telematics-settings.quarantined-delivery-retention-days"}} @helpText={{t "fleet-ops.admin-pages.telematics-settings.delete-quarantined-delivery-envelopes-across-all"}}>
                <Input @type="number" @value={{this.quarantineRetentionDays}} min="0" max="365" class="form-input w-full" />
            </InputGroup>
            <InputGroup @name={{t "fleet-ops.admin-pages.telematics-settings.sync-run-diagnostics-retention-days"}} @helpText={{t "fleet-ops.admin-pages.telematics-settings.delete-finished-sync-run-diagnostics-across"}}>
                <Input @type="number" @value={{this.syncRunRetentionDays}} min="0" max="365" class="form-input w-full" />
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "fleet-ops.admin-pages.telematics-settings.system-telemetry-activity-logging"}} @open={{true}} @wrapperClass="bordered-classic">
        <Toggle
            @label={{t "fleet-ops.admin-pages.telematics-settings.log-telemetry-activity"}}
            @helpText={{t "fleet-ops.admin-pages.telematics-settings.write-telemetry-driven-device-event-and"}}
            @isToggled={{this.logTelemetryActivity}}
            @onToggle={{fn (mut this.logTelemetryActivity)}}
        />
    </ContentPanel>

    <div class="flex justify-end">
        <Button
            @type="primary"
            @size="sm"
            @icon="save"
            @text={{t "fleet-ops.admin-pages.telematics-settings.save-system-policy"}}
            @onClick={{perform this.saveSettings}}
            @disabled={{or this.saveSettings.isRunning this.loadSettings.isRunning (not this.settingsLoaded)}}
            @isLoading={{or this.saveSettings.isRunning this.loadSettings.isRunning}}
        />
    </div>

    <ContentPanel @title={{t "settings.telematics.storage-usage"}} @open={{true}} @wrapperClass="bordered-classic">
        <p class="mb-3 text-sm text-gray-600 dark:text-gray-300">
            {{t "fleet-ops.admin-pages.telematics-settings.storage-usage-includes-telematics-data-across"}}
        </p>
        <div class="flex items-center justify-end gap-2 mb-3">
            <Button
                @size="xs"
                @icon="rotate"
                @text={{t "settings.telematics.refresh"}}
                @onClick={{perform this.loadUsage}}
                @disabled={{this.loadUsage.isRunning}}
                @isLoading={{this.loadUsage.isRunning}}
            />
            <Button
                @type="danger"
                @size="xs"
                @icon="broom"
                @text={{t "settings.telematics.run-cleanup"}}
                @onClick={{this.confirmRunCleanup}}
                @disabled={{or this.runCleanup.isRunning this.loadSettings.isRunning this.saveSettings.isRunning (not this.settingsLoaded)}}
                @isLoading={{this.runCleanup.isRunning}}
            />
        </div>
        {{#if this.usageRows.length}}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase text-gray-500 dark:text-gray-400">
                            <th class="py-2 pr-3">{{t "settings.telematics.table"}}</th>
                            <th class="py-2 pr-3 text-right">{{t "settings.telematics.rows"}}</th>
                            <th class="py-2 pr-3 text-right">{{t "settings.telematics.estimated-size"}}</th>
                            <th class="py-2 pl-6 text-right whitespace-nowrap">{{t "settings.telematics.oldest"}}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        {{#each this.usageRows as |row|}}
                            <tr class="text-gray-800 dark:text-gray-100">
                                <td class="py-2 pr-3">
                                    <div class="font-medium">{{row.label}}</div>
                                    {{#if row.raw_payload_rows}}
                                        <div class="text-xs text-gray-500 dark:text-gray-400">
                                            {{t "settings.telematics.raw-payload-rows" count=(format-number row.raw_payload_rows) compactable=(format-number row.compactable_rows)}}
                                        </div>
                                    {{/if}}
                                </td>
                                <td class="py-2 pr-3 text-right">
                                    {{#if (eq row.rows null)}}
                                        {{t "settings.telematics.not-available"}}
                                    {{else if row.rows_estimated}}
                                        {{t "settings.telematics.estimated-rows" count=(format-number row.rows)}}
                                    {{else}}
                                        {{format-number row.rows}}
                                    {{/if}}
                                </td>
                                <td class="py-2 pr-3 text-right">{{#if (or row.estimated_bytes (eq row.estimated_bytes 0))}}{{format-bytes row.estimated_bytes}}{{else}}{{t "settings.telematics.not-available"}}{{/if}}</td>
                                <td class="py-2 pl-6 text-right text-xs whitespace-nowrap">{{#if row.oldest}}{{row.oldest}}{{else}}{{t "settings.telematics.not-available"}}{{/if}}</td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">{{t "settings.telematics.space-reclaim-note"}}</p>
        {{else if this.loadUsage.isRunning}}
            <div class="flex items-center justify-center py-8">
                <Spinner />
            </div>
        {{else}}
            <div class="text-center py-8 text-sm text-gray-400 dark:text-gray-500">
                {{t "settings.telematics.usage-unavailable"}}
            </div>
        {{/if}}
    </ContentPanel>
    <Spacer @height="200px" />
</div>
